<?xml version="1.0"?>
<extension key="be.aivl.streetimport" type="module">
  <file>streetimport</file>
  <name>Bulk Importer</name>
  <description>Processes TM/DD Files</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Patrick Figel</author>
    <email>pfigel@greenpeace.org</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/greenpeace-cee/be.aivl.streetimport</url>
    <url desc="Documentation">https://github.com/greenpeace-cee/be.aivl.streetimport</url>
    <url desc="Support">https://github.com/greenpeace-cee/be.aivl.streetimport/issues</url>
    <url desc="Licensing">https://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-11-10</releaseDate>
  <version>3.0.0-beta.1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.69</ver>
  </compatibility>
  <comments>Based on AIVL's Street Recruitment Import</comments>
  <civix>
    <namespace>CRM/Streetimport</namespace>
    <format>24.09.1</format>
  </civix>
  <requires>
    <ext>de.systopia.identitytracker</ext>
    <ext>org.project60.banking</ext>
    <ext>org.project60.sepa</ext>
  </requires>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.1.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Streetimport\AutomaticUpgrader</upgrader>
</extension>
